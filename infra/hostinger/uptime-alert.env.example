# Install as /etc/streamx/uptime-alert.env and restrict it to root when using a webhook.
UPTIME_ALERT_WEBHOOK_URL=
UPTIME_ALERT_BACKEND_URL=http://127.0.0.1:8000/health/ready
UPTIME_ALERT_BACKEND_HOST_HEADER=api.alsyedinitiative.com
UPTIME_ALERT_FRONTEND_URL=http://127.0.0.1:3000/
UPTIME_ALERT_CERT_FILES=/etc/letsencrypt/live/alsyedinitiative.com/fullchain.pem,/etc/letsencrypt/live/adlfront.com/fullchain.pem
UPTIME_ALERT_CERT_WARN_DAYS=21
UPTIME_ALERT_DISK_USED_WARN_PERCENT=90
UPTIME_ALERT_MEMORY_USED_WARN_PERCENT=90
UPTIME_ALERT_REPEAT_EVERY=15
UPTIME_ALERT_CHECK_PROMETHEUS=1
UPTIME_ALERT_PROMETHEUS_URL=http://127.0.0.1:9090
