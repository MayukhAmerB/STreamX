# Phase 5 resource profile: live class broadcast day (OBS or browser Host Studio)
#
# Sized for the 8 vCPU host. These are hard CPU *ceilings* (`docker update
# --cpus`, a CFS quota), applied live without restarting anything. A quota is
# not a reservation: a capped container is throttled at its cap even while the
# rest of the host is idle. So the caps deliberately overcommit the machine
# (~19 vCPU of caps on 8 vCPU) and priority for the live feed comes from CPU
# *weight* instead: Owncast runs with cpu_shares 4096, 4x every other
# container (docker-compose.hostinger.resource-limits.yml), so whenever the
# box is saturated Owncast gets its share first.
#
# Never squeeze the web/DB tier on class day: during a class every HLS segment
# request is authorized by the backend through nginx auth_request, and joins,
# chat and heartbeats all hit backend -> pgbouncer -> postgres. Throttling
# that path stalls playback for every viewer even with idle CPU on the host.

# Live path: Owncast transcodes every viewer variant; LiveKit forwards the
# Host Studio feed and egress encodes it to RTMP (both idle on OBS days). Keep
# egress above its participant_cpu_cost (1.0, egress.yaml) or it refuses new
# egresses.
OWNCAST_CPUS=3.5
LIVEKIT_EGRESS_CPUS=1.5
LIVEKIT_CPUS=1.5

# Web/DB tier: HLS auth_request, joins, chat bridge, heartbeats, polling.
POSTGRES_CPUS=2.0
REDIS_CPUS=1.0
BACKEND_CPUS=2.0
# Applies to each of backend-2/3/4.
BACKEND_POOL_CPUS=1.5
GATEWAY_CPUS=0.75
PGBOUNCER_CPUS=0.75
MEDIA_CPUS=0.75
FRONTEND_CPUS=0.75

# Work that can wait until after class.
WORKER_CPUS=0.25
TRANSCODER_CPUS=0.25
