[Unit]
Description=StreamX autoheal: restart unhealthy labelled containers (with a budget)
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
# Optional: AUTOHEAL_ALERT_CMD, AUTOHEAL_MAX_RESTARTS, AUTOHEAL_WINDOW_SECONDS
EnvironmentFile=-/etc/streamx/autoheal.env
WorkingDirectory=/opt/alsyed/StreamX
ExecStart=/opt/alsyed/StreamX/infra/hostinger/autoheal.sh
Nice=5
