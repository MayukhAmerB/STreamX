{
  "name": "alsyedacademy-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build && node scripts/check-motion-size.mjs",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "lint": "eslint \"src/**/*.{js,jsx,ts,tsx}\" && node scripts/check-motion.mjs && node scripts/check-palette.mjs",
    "lint:motion": "node scripts/check-motion.mjs",
    "lint:palette": "node scripts/check-palette.mjs",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/build-tokens.mjs",
    "tokens:check": "node scripts/build-tokens.mjs --check",
    "contract:generate": "openapi-typescript ../contracts/openapi.yaml -o src/api/generated/schema.ts",
    "test": "vitest run",
    "quality": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@carbon/icons-react": "11.91.0",
    "@carbon/react": "1.119.0",
    "@ibm/plex-sans": "1.1.0",
    "@radix-ui/react-accordion": "1.3.1",
    "@radix-ui/react-avatar": "1.3.1",
    "@radix-ui/react-checkbox": "1.4.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-separator": "1.2.0",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-switch": "1.4.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-toast": "1.3.1",
    "@radix-ui/react-toggle-group": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "axios": "^1.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hls.js": "^1.6.15",
    "livekit-client": "^2.15.5",
    "motion": "13.5.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.4",
    "tailwind-merge": "2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource/handlee": "5.3.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.38.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^16.4.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.3",
    "react-reconciler": "0.27.0",
    "sass": "1.106.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^5.4.19",
    "vitest": "^3.2.4"
  }
}
