EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
DEFAULT_FROM_EMAIL=alsyedinitiative@gmail.com
CONTACT_RECEIVER_EMAIL=contact@adlfront.com

# App security knobs
FFMPEG_BINARY=ffmpeg
SECURITY_BLOCK_SUSPICIOUS_INPUT=1
SECURITY_MAX_INSPECTION_BODY_BYTES=16384
AUTH_MIN_PASSWORD_LENGTH=12
AUTH_LOGIN_MAX_FAILURES=10
AUTH_LOGIN_LOCKOUT_SECONDS=3600
ACCOUNT_SELF_SERVICE_CREDENTIALS_ENABLED=0
DATA_UPLOAD_MAX_MEMORY_SIZE=2621440
FILE_UPLOAD_MAX_MEMORY_SIZE=2621440
MAX_VIDEO_UPLOAD_BYTES=2147483648
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000
TRUST_X_FORWARDED_FOR=0
TRUSTED_PROXY_COUNT=1

# Production hard-fail controls
ENFORCE_PRODUCTION_REQUIREMENTS=1
ALLOW_SQLITE_IN_PRODUCTION=0
ALLOW_INSECURE_HTTP_ORIGINS=0
SECURE_HSTS_SECONDS_FLOOR=31536000

# Logging
LOG_LEVEL=INFO
DJANGO_SECURITY_LOG_LEVEL=INFO
PERF_MONITORING_ENABLED=1
PERF_DB_QUERY_TRACKING_ENABLED=1
PERF_DB_QUERY_SAMPLE_RATE=1.0
PERF_SLOW_QUERY_MS=120
PERF_DEFAULT_ENDPOINT_BUDGET_MS=800
PERF_WARN_QUERY_COUNT=30
PERF_WARN_QUERY_TIME_MS=300
PERF_LOG_ALL_REQUESTS=0
PERF_RESPONSE_TIME_HEADER_ENABLED=1
PERF_PATH_BUDGETS=/api/realtime/sessions/=650,/api/live-classes/=450,/api/courses/=550,/api/lectures/=650,/api/auth/=500
PERF_LOG_LEVEL=INFO
REALTIME_TELEMETRY_LOG_LEVEL=INFO

# Async jobs / workers
ASYNC_JOBS_ENABLED=1
ASYNC_JOBS_POLL_SECONDS=10
ASYNC_JOBS_LOCK_TIMEOUT_SECONDS=300
ASYNC_EMAIL_MAX_ATTEMPTS=5
ASYNC_WEBHOOK_RETRY_MAX_ATTEMPTS=6
ASYNC_PAYMENT_PROVISION_MAX_ATTEMPTS=8
ASYNC_JOBS_BATCH_SIZE=100
ASYNC_JOBS_WORKER_POLL_SECONDS=1
ASYNC_WORKER_REPLICAS=2

# Reliability building blocks (apps/core/README.md); defaults shown.
# Transactional outbox, drained by process_async_jobs.
OUTBOX_DEFAULT_MAX_ATTEMPTS=8
OUTBOX_LOCK_TIMEOUT_SECONDS=300
OUTBOX_BACKOFF_BASE_SECONDS=15
OUTBOX_MAX_BACKOFF_SECONDS=3600
OUTBOX_RETENTION_DAYS=14
# Idempotency-Key storage for unsafe API calls.
IDEMPOTENCY_KEY_TTL_SECONDS=86400
IDEMPOTENCY_LEASE_SECONDS=60
# Outbound HTTP default timeout and circuit breakers (shared via Redis).
OUTBOUND_HTTP_DEFAULT_TIMEOUT_SECONDS=5
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_FAILURE_WINDOW_SECONDS=60
CIRCUIT_BREAKER_OPEN_SECONDS=30
CIRCUIT_BREAKER_PROBE_TIMEOUT_SECONDS=15
# /health/ready memo and MEDIA_ROOT free-space thresholds (bytes).
HEALTH_READINESS_CACHE_SECONDS=3
HEALTH_MEDIA_MIN_FREE_BYTES=536870912
HEALTH_MEDIA_WARN_FREE_BYTES=5368709120

# --- Weekly reports: private storage + antivirus (apps/reports/SECURITY.md) ---
# On the VPS these are the noexec host directories /srv/streamx/reports{,-quarantine}
# bind-mounted at the paths below (the defaults inside the backend image).
REPORTS_PRIVATE_ROOT=/app/private_media
REPORTS_QUARANTINE_ROOT=/app/private_quarantine
# clamd in production (default there; anything else is refused at startup).
# Local development and tests may use "fake" (flags EICAR / STREAMX-TEST-VIRUS markers).
REPORTS_ANTIVIRUS_SCANNER=clamd
CLAMD_HOST=clamav
CLAMD_PORT=3310
CLAMD_CONNECT_TIMEOUT_SECONDS=5
CLAMD_TIMEOUT_SECONDS=120
CLAMD_STREAM_MAX_BYTES=220200960
REPORTS_RESCAN_INTERVAL_HOURS=24
REPORTS_RESCAN_BATCH_SIZE=200
# ClamAV container memory (one full signature engine ~1.3 GB).
CLAMAV_MEM_LIMIT=3g
CLAMAV_MEM_RESERVATION=1536m
CLAMAV_CPUS=2.0

# Dedicated payment API pool (2 x 2 workers x 16 threads = 64 request slots)
PAYMENT_WEB_CONCURRENCY=2
PAYMENT_GUNICORN_THREADS=16
PAYMENT_GUNICORN_TIMEOUT=30
RAZORPAY_HTTP_TIMEOUT_SECONDS=12
PAYMENT_IDEMPOTENCY_LEASE_SECONDS=60
PAYMENT_ORDER_RESUME_MAX_AGE_SECONDS=3600
# Razorpay retries (transient failures only, inside the deadline) and replay window.
RAZORPAY_HTTP_MAX_ATTEMPTS=2
RAZORPAY_HTTP_RETRY_DEADLINE_SECONDS=20
PAYMENT_WEBHOOK_MAX_AGE_SECONDS=259200
# Per-IP ceiling on checkout/verify, the webhook's own budget, billing budgets.
PAYMENT_IP_RATE=300/minute
PAYMENT_WEBHOOK_RATE=1200/minute
PLAN_VERIFY_RATE=120/hour
BILLING_CHECKOUT_RATE=30/hour
BILLING_VERIFY_RATE=120/hour
# Stuck-payment reconciliation (process_async_jobs). Off until enabled; try
# `manage.py reconcile_payments` (dry run) first.
PAYMENT_RECONCILE_ENABLED=0
PAYMENT_RECONCILE_INTERVAL_SECONDS=900
PAYMENT_RECONCILE_MIN_AGE_MINUTES=20
PAYMENT_RECONCILE_MAX_AGE_HOURS=72
PAYMENT_RECONCILE_BATCH_SIZE=25
PAYMENT_RECONCILE_SUPERSEDE_AFTER_HOURS=24

# Browser push notifications
# Generate a VAPID key pair before enabling push in production.
WEB_PUSH_ENABLED=0
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:support@alsyedinitiative.com

# Gunicorn
GUNICORN_BIND=0.0.0.0:8000
WEB_CONCURRENCY=2
GUNICORN_THREADS=2
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=10000
GUNICORN_MAX_REQUESTS_JITTER=1000
GUNICORN_WORKER_TMP_DIR=/dev/shm
GUNICORN_LOG_LEVEL=info
GUNICORN_FORWARDED_ALLOW_IPS=*

# Optional container resource limits (Hostinger Phase 2+)
POSTGRES_CPUS=2.0
POSTGRES_MEM_LIMIT=8g
POSTGRES_MEM_RESERVATION=4g
REDIS_CPUS=1.0
REDIS_MEM_LIMIT=2g
REDIS_MEM_RESERVATION=1g
BACKEND_CPUS=2.5
BACKEND_MEM_LIMIT=6g
BACKEND_MEM_RESERVATION=3g
BACKEND_POOL_CPUS=1.5
BACKEND_POOL_MEM_LIMIT=2g
BACKEND_POOL_MEM_RESERVATION=1g
WORKER_CPUS=1.0
WORKER_MEM_LIMIT=1.5g
WORKER_MEM_RESERVATION=768m
TRANSCODER_CPUS=1.2
TRANSCODER_MEM_LIMIT=3g
TRANSCODER_MEM_RESERVATION=1.5g
LIVEKIT_CPUS=2.0
LIVEKIT_MEM_LIMIT=6g
LIVEKIT_MEM_RESERVATION=3g
LIVEKIT_EGRESS_CPUS=1.5
LIVEKIT_EGRESS_MEM_LIMIT=4g
LIVEKIT_EGRESS_MEM_RESERVATION=2g
OWNCAST_CPUS=0.5
OWNCAST_MEM_LIMIT=3g
OWNCAST_MEM_RESERVATION=1g
OWNCAST_CPU_SHARES=4096
MEDIA_CPUS=0.75
MEDIA_MEM_LIMIT=1g
MEDIA_MEM_RESERVATION=512m
FRONTEND_CPUS=0.75
FRONTEND_MEM_LIMIT=1g
FRONTEND_MEM_RESERVATION=512m
GATEWAY_CPUS=0.75
GATEWAY_MEM_LIMIT=512m
GATEWAY_MEM_RESERVATION=256m
PGBOUNCER_CPUS=0.75
PGBOUNCER_MEM_LIMIT=512m
PGBOUNCER_MEM_RESERVATION=256m
# OSINT CTF examinations (apps.ctf, taken on labs.alsyedinitiative.com)
# Answer-hash key: a separate secret, >= 32 chars, NOT the Django secret key.
# Missing or weak in production: exams only are switched off (check ctf.I001/I003).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Rotating it means reloading every exam file (load_ctf_exam --allow-content-change).
CTF_ANSWER_PEPPER=
# Origins of the labs site (path-scoped CORS + CSRF trust; never put them in CORS_ALLOWED_ORIGINS).
CTF_LABS_ORIGINS=https://labs.alsyedinitiative.com
CTF_ATTEMPT_RATE=30/minute
CTF_READ_RATE=240/minute
# --- Phase 3: exam lifecycle (apps/ctf/scheduler.py), evidence and gradebook ---
# ctf.scheduler: auto-publish at opens_at, auto-close, expire, results to the gradebook.
CTF_SCHEDULER_ENABLED=true
CTF_SCHEDULER_INTERVAL_SECONDS=60
CTF_OPENING_SOON_MINUTES=60
# Where exam notifications and the Console card send students.
CTF_LABS_EXAM_URL=https://labs.alsyedinitiative.com/#exam
# Evidence uploaded in Console -> Exams: signed URL lifetime and per-file cap.
CTF_MATERIAL_URL_TTL_SECONDS=7200
CTF_MATERIAL_MAX_UPLOAD_MB=25

# --- Phase 2: live-class lifecycle (apps/realtime/lifecycle.py, reconciler.py) ---
# off | shadow | enforce. Start in shadow (logs the transitions it would make,
# writes nothing) for two class weekends, then switch to enforce.
LIVE_RECONCILER_MODE=shadow
LIVE_RECONCILER_INTERVAL_SECONDS=5
# Host reconnect grace before an interrupted stream is declared stopped.
REALTIME_HOST_GRACE_SECONDS=60
REALTIME_HOST_HEARTBEAT_TTL_SECONDS=30
# A live class with no feed and a silent host for this long is ended automatically.
REALTIME_ABANDONED_END_MINUTES=20
REALTIME_STREAM_STARTING_TIMEOUT_SECONDS=180
REALTIME_EGRESS_RESTART_BACKOFF_SECONDS=5
# Go Live answers 202 and the worker starts the egress.
REALTIME_ASYNC_GO_LIVE=1
# Calendar-aware resource profile (broadcast 15 min before class / on Go Live,
# content 10 min after). Turn on after the shadow weekends.
REALTIME_AUTO_RESOURCE_PROFILE=0
REALTIME_PRECLASS_PROBE_ENABLED=1
# Egress health port (egress.yaml health_port, inside LiveKit's network namespace).
LIVEKIT_EGRESS_HEALTH_URL=http://livekit:7981/
# Set by docker-compose.hostinger.async-workers.yml for the worker healthcheck.
# WORKER_HEARTBEAT_FILE=/tmp/worker-heartbeat
# --- end Phase 2 live-class lifecycle ---

# --- Phase 2: no-click automatic class recordings (apps/realtime/recording) ---
# Every broadcast (OBS and Host Studio) is recorded by the stream-recorder
# service; there is no Start/Stop Recording button. Rollback: set to 0 (OBS
# sessions only, and only while STREAM_RECORDER_ENABLED=1).
RECORDING_AUTO_ALL_BROADCASTS=1
# Follows RECORDING_AUTO_ALL_BROADCASTS when unset; set 0 to stop all new captures.
# STREAM_RECORDER_ENABLED=1
# Meetings are NEVER auto-recorded (owner decision: broadcasts only). Keep 0:
# a meeting captures students' cameras and microphones. If ever set to 1, a
# LiveKit room-composite egress records each live meeting and the file is held
# unpublished and flagged "needs review" for an admin (recording.reconcile).
RECORDING_AUTO_MEETINGS=0
RECORDING_RECONCILE_INTERVAL_SECONDS=30
RECORDING_RECONCILE_LOOKBACK_HOURS=24
# Publish the MP4 as soon as the class is finalized; HLS (HD) follows.
RECORDING_INSTANT_PUBLISH=1
# Section auto-created in the course when no module can be derived (flagged "needs review").
RECORDING_AUTO_MODULE_TITLE=Class recordings
# One take per class: Stop waits this long for a restart; a feed offline this long finalizes.
STREAM_RECORDER_STOP_GRACE_SECONDS=600
STREAM_RECORDER_IDLE_FINALIZE_SECONDS=900
RECORDING_AUTO_RETRY_MAX=3
RECORDING_AUTO_RETRY_BACKOFF_SECONDS=300,1800,7200
RECORDING_IMPORT_SCAN_INTERVAL_SECONDS=3600
RECORDING_IMPORT_AUTO_PUBLISH=1
RECORDING_ALERTS_ENABLED=1
RECORDING_PROCESSING_ALERT_SECONDS=21600
RECORDING_FINALIZING_ALERT_SECONDS=3600
RECORDING_HEARTBEAT_ALERT_SECONDS=180
# Nightly verify_recording_pipeline in the stream-recorder (local hour, TIME_ZONE).
RECORDING_CANARY_ENABLED=1
RECORDING_CANARY_HOUR=3
# The canary holds one rolled-back transaction for minutes, so it connects
# directly to PostgreSQL (not PgBouncer) with statement/idle-in-transaction
# timeouts lifted. Default: DATABASE_MIGRATE_URL, else DATABASE_URL with the
# @pgbouncer host rewritten to @postgres:5432.
# RECORDING_CANARY_DATABASE_URL=postgresql://user:pass@postgres:5432/db
# Set by docker-compose.hostinger.async-workers.yml for the recorder healthcheck.
# STREAM_RECORDER_HEARTBEAT_FILE=/tmp/stream-recorder-heartbeat
# Transcoder: one ffmpeg pass, veryfast + capped CRF, timeout, retries, blue/green HLS.
# Rollback: COURSE_HLS_SINGLE_PASS=0 (per-rendition, COURSE_HLS_X264_PRESET/COURSE_HLS_CRF).
COURSE_HLS_SINGLE_PASS=1
COURSE_HLS_SINGLE_PASS_PRESET=veryfast
COURSE_HLS_SINGLE_PASS_CRF=23
COURSE_HLS_TOP_RUNG_COPY=0
COURSE_HLS_TRANSCODE_TIMEOUT_BASE_SECONDS=600
COURSE_HLS_TRANSCODE_TIMEOUT_FACTOR=3
COURSE_HLS_TRANSCODE_MAX_TIMEOUT_SECONDS=21600
COURSE_HLS_MAX_ATTEMPTS=5
COURSE_HLS_RETRY_BACKOFF_SECONDS=60,300,1800,7200
COURSE_HLS_REVISION_GRACE_SECONDS=86400
# TRANSCODER_HEARTBEAT_FILE=/tmp/transcoder-heartbeat
# --- end Phase 2 no-click recordings ---

# --- Resumable class recording uploads (apps/recording_uploads; Console -> Upload recording, tools/obs-uploader) ---
# 32 MiB chunks stay below Cloudflare's 100 MB body limit: no grey-cloud switch needed.
# Staging defaults to <REPORTS_PRIVATE_ROOT>/.recording-uploads (inside the noexec private volume, never MEDIA_ROOT).
# RECORDING_UPLOAD_STAGING_ROOT=/app/private_media/.recording-uploads
RECORDING_UPLOAD_CHUNK_BYTES=33554432
RECORDING_UPLOAD_MAX_BYTES=8589934592
RECORDING_UPLOAD_EXPIRY_HOURS=48
RECORDING_UPLOAD_MAX_ACTIVE_PER_USER=3
RECORDING_UPLOAD_MIN_FREE_BYTES=2147483648
RECORDING_UPLOAD_REVERT_RETENTION_DAYS=14
RECORDING_UPLOAD_CREATE_RATE=60/hour
RECORDING_UPLOAD_CHUNK_RATE=1200/hour
RECORDING_UPLOAD_READ_RATE=600/hour
RECORDING_UPLOAD_TOKEN_RATE=20/hour
# --- end resumable recording uploads ---

# Certification delivery (apps.certification). WhatsApp stays DISABLED until the first three are set.
CERTIFICATION_EMAIL_FROM=
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_CERTIFICATE=
WHATSAPP_TEMPLATE_LETTER=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_VERSION=v21.0
WHATSAPP_DEFAULT_COUNTRY_CODE=91

# Attendance: classes that went on air before this ISO datetime (no live
# presence was recorded for them) are never finalised, so no student is
# marked absent for them. Empty = no cut-off.
ATTENDANCE_TRACKING_SINCE=
# Attendance: only batches (course ids) at or above this are tracked and judged.
# Empty = every course. Production: 28 (Batch IV and later).
ATTENDANCE_FROM_COURSE_ID=

# Paid-buyer login delivery: auto-generate + send to registered email and WhatsApp.
PAYMENT_AUTO_CREDENTIALS_ENABLED=1
CREDENTIALS_EMAIL_FROM=
CREDENTIALS_EMAIL_TIMEOUT_SECONDS=15
# Approved template; body {{1}} name, {{2}} course, {{3}} login URL, {{4}} username, {{5}} password.
WHATSAPP_TEMPLATE_CREDENTIALS=
